# Copy to .env and adjust for your environment.
# Vite only exposes env vars prefixed with VITE_ to browser code.

VITE_SERVER_URL=http://localhost:3000

# Routes are NOT configured here — each entity type's route is derived
# automatically from its chart (see src/entity-types.ts). The Server must
# be told to host every route it needs to serve (RLJSON_ROUTES, see the
# Server repo's .env.example) before this app can reach it.
